{
  "name": "obsidian-prism",
  "version": "1.0.8-beta.4",
  "description": "Obsidian Prism (Русская версия / форк RMvdesi/obsidian-prism) — оптический интерфейс, пружинная физика, темы, 512K-колба контекста, слайдер рассуждений и переводчик мыслей для Antigravity с полной локализацией на русский язык.",
  "license": "GPL-3.0-only",
  "author": "RMvdesi",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daimestrike/obsidian-prism.git"
  },
  "homepage": "https://github.com/daimestrike/obsidian-prism#readme",
  "bugs": {
    "url": "https://github.com/daimestrike/obsidian-prism/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "antigravity",
    "theme",
    "optical-ui",
    "spring-motion",
    "webgl2",
    "telemetry",
    "thought-translator",
    "russian",
    "i18n"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs test/gates/*.test.mjs",
    "test:gates": "node scripts/run-tests.mjs --gates",
    "test:fast": "node scripts/run-tests.mjs --fast",
    "version:check": "node scripts/bump-version.mjs --check",
    "compat:probe": "node scripts/probe-host-compat.mjs",
    "workbench": "node workbench/server.cjs",
    "inject": "node inject.js",
    "watch": "node inject.js --watch",
    "daemon": "node sidecars/daemon/main.mjs",
    "remove": "node remove.js",
    "install:plugin": "node tools/install-plugin.cjs --install",
    "archive:conversations": "node sidecars/daemon/conversation-archive.mjs",
    "build:installer": "node scripts/build-installer.mjs --out dist/obsidian-prism-installer.exe",
    "build:macos": "node scripts/build-macos.mjs"
  }
}
